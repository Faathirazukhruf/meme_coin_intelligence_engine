# Server Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/meme_coin_intelligence?schema=public"

# Redis Cache & Streams
REDIS_URL="redis://localhost:6379"

# S3 / MinIO Storage
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadminpassword"
S3_BUCKET_RAW_EVENTS="raw-events"
S3_BUCKET_BACKTESTS="backtest-artifacts"
S3_FORCE_PATH_STYLE=true

# Solana / Chain Provider Configurations
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
HELIUS_API_KEY=""
HELIUS_RPC_URL=""
BITQUERY_API_KEY=""
BIRDEYE_API_KEY=""
DEXSCREENER_API_URL="https://api.dexscreener.com"

# Social / Narrative Providers (Optional in V1)
TWITTER_BEARER_TOKEN=""
TELEGRAM_BOT_TOKEN=""

# Engine Versioning Constants
DATASET_VERSION="dataset_v1"
PARSER_VERSION="parser_v1"
FEATURE_VERSION="feature_v1"
RISK_VERSION="risk_v1"
OPPORTUNITY_VERSION="opportunity_v1"
SCORING_VERSION="scoring_v1"
DECISION_VERSION="decision_v1"
STRATEGY_VERSION="strategy_v1"
CODE_VERSION="1.0.0"
