{
  "name": "meme-coin-intelligence-engine",
  "version": "0.1.0",
  "private": true,
  "description": "On-chain meme coin discovery, risk analysis, opportunity scoring, signal generation, paper execution, and quantitative backtesting system.",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @meme-coin/api dev",
    "dev:all": "pnpm -r --parallel run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "db:generate": "prisma generate --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:studio": "prisma studio --schema=./prisma/schema.prisma"
  },
  "devDependencies": {
    "@prisma/client": "6.4.1",
    "@types/node": "^22.13.8",
    "eslint": "^9.21.0",
    "prettier": "^3.5.2",
    "prisma": "6.4.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
